          "min_prominence_db": 6,
          "weight": 2
        },
        {
          "type": "present",
          "at": "bsf",
          "min_prominence_db": 6,
          "weight": 1
        }
      ],
      "advice": "Plan bearing inspection. Rolling element damage often also shows cage frequency sidebands."
    },
    {
      "id": "bearing_cage",
