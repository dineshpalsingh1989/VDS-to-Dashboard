{
  "about": "Fault symptom library for the AI advisor. Each fault lists evidence found in the spectrum, the time waveform and the sensor direction. Rules with \"source\": \"envelope\" are checked against the envelope spectrum computed from the waveform, which shows bearing impacts early; others use the normal spectrum. A fault is only suggested when the spectrum or waveform has CHANGED from the learned normal and the evidence matches. Frequencies: 1x = shaft speed, 2x = twice shaft speed, line = mains frequency, bpfo/bpfi/bsf/ftf = bearing defect frequencies, gmf = gear mesh (teeth x 1x), bpf = blade/vane pass (blades x 1x). A number in front multiplies, e.g. 2bpfo. Evidence marked key must match; negate means the evidence must NOT be present (for example, many running-speed harmonics rule out an electrical cause). Weights set how much each item counts.",
  "version": 2,
  "faults": [
    {
      "id": "unbalance",
      "name": "Unbalance",
      "requires": [
        "rpm"
      ],
      "evidence": [
        {
          "type": "rise",
          "at": "1x",
          "min_db": 6,
          "weight": 3,
          "key": true
        },
        {
          "type": "present",
          "at": "1x",
          "min_prominence_db": 15,
          "weight": 1
        },
        {
          "type": "ratio",
          "at": "2x",
          "to": "1x",
          "max": 0.5,
          "weight": 1
        },
        {
          "type": "direction",
          "any": [
            "radial",
            "horizontal",
            "vertical"
          ],
          "weight": 1
        }
      ],
      "advice": "Look for material build-up, a lost balance weight, or a damaged fan or impeller. Confirm with a phase reading before balancing."
    },
    {
      "id": "misalignment",
      "name": "Shaft misalignment",
      "requires": [
        "rpm"
      ],
      "evidence": [
        {
          "type": "rise",
          "at": "2x",
          "min_db": 6,
          "weight": 3,
          "key": true
        },
        {
          "type": "ratio",
          "at": "2x",
          "to": "1x",
          "min": 0.5,
          "weight": 2
        },
        {
          "type": "present",
          "at": "3x",
          "min_prominence_db": 8,
          "weight": 1
        },
        {
          "type": "direction",
          "any": [
            "axial"
          ],
          "weight": 1
        }
      ],
      "advice": "Check coupling alignment and soft foot, especially after recent maintenance. High axial vibration supports this."
    },
    {
      "id": "looseness",
      "name": "Mechanical looseness",
      "requires": [
        "rpm"
      ],
      "evidence": [
        {
          "type": "harmonics",
          "of": "1x",
          "count": 5,
          "min_prominence_db": 8,
          "weight": 3,
          "key": true
        },
        {
          "type": "present",
          "at": "1.5x",
          "min_prominence_db": 6,
          "weight": 1
        },
        {
          "type": "present",
          "at": "2.5x",
          "min_prominence_db": 6,
          "weight": 1
        },
        {
          "type": "rise",
          "at": "3x",
          "min_db": 6,
          "weight": 1
        },
        {
          "type": "waveform",
          "feature": "crest",
          "min": 4,
          "weight": 1
        }
      ],
      "advice": "Check foundation and hold-down bolts, cracked bases or frames, and bearing fits in their housings."
    },
    {
      "id": "bearing_outer_race",
      "name": "Bearing outer race defect",
      "requires": [
        "rpm",
        "bearing"
      ],
      "evidence": [
        {
          "type": "rise",
          "at": "bpfo",
          "min_db": 6,
          "weight": 3,
          "key": true
        },
        {
          "type": "harmonics",
          "of": "bpfo",
          "count": 2,
          "min_prominence_db": 6,
          "weight": 2
        },
        {
          "type": "waveform",
          "feature": "kurtosis",
          "min": 4,
          "weight": 1
        }
      ],
      "advice": "Plan bearing inspection. Check lubrication now; outer race damage usually progresses steadily, so trend it weekly."
    },
    {
      "id": "bearing_inner_race",
      "name": "Bearing inner race defect",
      "requires": [
        "rpm",
        "bearing"
      ],
      "evidence": [
        {
          "type": "rise",
          "at": "bpfi",
          "min_db": 6,
          "weight": 3,
          "key": true
        },
        {
          "type": "sidebands",
          "at": "bpfi",
          "spacing": "1x",
          "min_prominence_db": 6,
          "weight": 2
        },
        {
          "type": "harmonics",
          "of": "bpfi",
          "count": 2,
          "min_prominence_db": 6,
          "weight": 1
        },
        {
          "type": "waveform",
          "feature": "kurtosis",
          "min": 4,
          "weight": 1
        }
      ],
      "advice": "Plan bearing replacement. Inner race defects tend to progress faster than outer race defects; shorten the inspection interval."
    },
    {
      "id": "bearing_rolling_element",
      "name": "Bearing rolling element (ball/roller) defect",
      "requires": [
