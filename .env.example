# Set these in the service environment; app.py does not automatically load this file.
VDS_HOST=127.0.0.1
VDS_PORT=8050
VDS_ADMIN_USER=admin
VDS_ADMIN_PASSWORD=
# Optional read-only account (requires an administrator password above).
VDS_VIEWER_USER=viewer
VDS_VIEWER_PASSWORD=
# Bind industrial protocols to a trusted interface explicitly for PLC access.
VDS_PROTOCOL_HOST=127.0.0.1
VDS_MODBUS_PORT=502
# VDS_DATA_DIR=/var/lib/wilcoxon-vds
# VDS_CONFIG_DIR=/var/lib/wilcoxon-vds/config
# Retention is disabled at 0. Scheduled maintenance takes a verified backup first.
VDS_TREND_RETENTION_DAYS=0
VDS_RAW_RETENTION_DAYS=0
VDS_ALARM_RETENTION_DAYS=0
# Machine history: one spectrum and waveform per channel every N seconds (0 is off),
# kept for the given number of days.
VDS_SNAPSHOT_INTERVAL_S=1800
VDS_SNAPSHOT_RETENTION_DAYS=90
# IRIV Edge AI only: 1 turns on the AI settings, spectrum fault lines and learning samples.
# iriv-edge/install.sh sets it; leave 0 on other hardware.
VDS_EDGE_AI=0
# AI advisor learning samples: one spectrum and waveform per channel every N seconds,
# only for VDS units whose AI switch is on in the AI page. 0 turns sampling off.
# Each channel keeps only the last VDS_LEARNING_RETENTION_HOURS of samples.
VDS_LEARNING_INTERVAL_S=600
VDS_LEARNING_RETENTION_HOURS=6
# Docker: local-only dashboard publication; set deliberately for LAN access.
VDS_BIND_ADDRESS=127.0.0.1
# Optional: select a published version with docker/compose.image.yaml.
# VDS_IMAGE=ghcr.io/dineshpalsingh1989/wilcoxon-vds:1.1.0
# Existing Docker installs can retain their original project's data volume:
# COMPOSE_PROJECT_NAME=your-original-project-name
